--------------------------------------------------
-- WEAPON DETECTION
--------------------------------------------------
local function detectWeapon(player)
    local function scan(container)
        if not container then return nil end
        for _,t in ipairs(container:GetChildren()) do
            if t:IsA("Tool") then
                local n = t.Name:lower()
                if n:find("gun") then return "gun" end
                if n:find("knife") or n:find("blade") then return "knife" end
            end
        end
    end
    return scan(player.Character) or scan(player:FindFirstChild("Backpack"))
end

--------------------------------------------------
-- DROPPED GUN
--------------------------------------------------
local function getDroppedGun()
    for _,obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("Tool") and obj:FindFirstChild("Handle") then
            if not obj.Parent:FindFirstChildOfClass("Humanoid") then
                return obj
            end
        end
    end
end

--------------------------------------------------
-- VISIBILITY CHECK (NO WALLS)
--------------------------------------------------
local rayParams = RaycastParams.new()
rayParams.FilterType = Enum.RaycastFilterType.Blacklist
rayParams.IgnoreWater = true

local function isVisible(head)
    if not LocalPlayer.Character or not LocalPlayer.Character:FindFirstChild("Head") then
        return false
    end

    rayParams.FilterDescendantsInstances = {LocalPlayer.Character}

    local origin = Camera.CFrame.Position
    local direction = head.Position - origin

    local result = workspace:Raycast(origin, direction, rayParams)

    if not result then return true end
    return result.Instance:IsDescendantOf(head.Parent)
end

--------------------------------------------------
-- ESP
--------------------------------------------------
local function removeESP(player)
    if HL[player] then HL[player]:Destroy() HL[player] = nil end
    if LABELS[player] then LABELS[player]:Destroy() LABELS[player] = nil end
end

local function createESP(player)
    if HL[player] then return end
    local char = player.Character
    if not char or not char:FindFirstChild("Head") then return end

    local h = Instance.new("Highlight", char)
    h.Adornee = char
    h.FillTransparency = 0.5
    h.OutlineTransparency = 0.3
    h.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    HL[player] = h

    local bb = Instance.new("BillboardGui", char.Head)
    bb.Size = UDim2.fromOffset(200,30)
    bb.StudsOffset = Vector3.new(0,2.5,0)
    bb.AlwaysOnTop = true

    local t = Instance.new("TextLabel", bb)
    t.Size = UDim2.fromScale(1,1)
    t.BackgroundTransparency = 1
    t.TextStrokeTransparency = 0
    t.Font = Enum.Font.GothamBold
    t.TextSize = 14
    LABELS[player] = t
end

--------------------------------------------------
-- TARGET
--------------------------------------------------
local function getTarget()
    local best,dist = nil,math.huge

    for p,_ in pairs(HL) do
        if p ~= LocalPlayer and p.Character and p.Character:FindFirstChild("Head") then
            local head = p.Character.Head

            if isVisible(head) then
                local w = detectWeapon(p)

                if (FOCUS_GUN and w ~= "gun") or (FOCUS_KNIFE and w ~= "knife") then
                    continue
                end

                local d = (head.Position - Camera.CFrame.Position).Magnitude
                if d < dist then
                    dist = d
                    best = head
                end
            end
        end
    end

    return best
end

--------------------------------------------------
-- LOOP
--------------------------------------------------
RunService.RenderStepped:Connect(function()

    for _,p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer then
            if ESP_ENABLED then createESP(p) else removeESP(p) end
        end
    end

    for p,h in pairs(HL) do
        if not p.Character then removeESP(p) continue end
        local w = detectWeapon(p)
        local l = LABELS[p]

        if l then
            if w == "gun" then
                h.FillColor = COLOR_GUN
                l.Text = "@"..p.Name.." | Sheriff"
            elseif w == "knife" then
                h.FillColor = COLOR_KNIFE
                l.Text = "@"..p.Name.." | Murderer"
            else
                h.FillColor = COLOR_SURVIVOR
                l.Text = "@"..p.Name.." | Survivor"
            end
        end
    end

    if AIMBOT_ENABLED then
        LocalPlayer.CameraMode = Enum.CameraMode.LockFirstPerson

        if LOCKED_TARGET then
            if not LOCKED_TARGET.Parent or not isVisible(LOCKED_TARGET) then
                LOCKED_TARGET = nil
            end
        end

        if not LOCKED_TARGET then
            LOCKED_TARGET = getTarget()
        end

        if LOCKED_TARGET then
            Camera.CFrame = CFrame.new(Camera.CFrame.Position, LOCKED_TARGET.Position)
        end
    else
        LocalPlayer.CameraMode = Enum.CameraMode.Classic
        LOCKED_TARGET = nil
    end
end)

